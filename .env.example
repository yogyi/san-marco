NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Thank-you purchase emails via Gmail SMTP (recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sanmarcofurnishings@gmail.com
SMTP_PASS=your_16_char_google_app_password
EMAIL_FROM=San Marco <sanmarcofurnishings@gmail.com>
ORDER_NOTIFY_EMAIL=sanmarcofurnishings@gmail.com

# Optional fallback — Resend
# RESEND_API_KEY=re_xxxxxxxx

# Optional — remote mail host when this deploy has no SMTP
# EMAIL_RELAY_URL=https://san-marco-beta.vercel.app/api/orders/confirm

# Optional — WhatsApp Cloud API thank-you to customer phone
# WHATSAPP_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=1234567890
# WHATSAPP_TEMPLATE_NAME=order_thank_you
# WHATSAPP_TEMPLATE_LANG=en

# Delhivery One — India shipping (create PENDING sale order after checkout)
# D1_CLIENT_ID=ucp-service-cli
# D1_CLIENT_SECRET=your_delhivery_client_secret
# D1_AUTH_URL=https://ucp-auth.delhivery.com/facelessvoid
# D1_REALM=ucp-xxxxxxxx
# D1_CLIENT_CMS=cms::client::xxxxxxxx
# D1_MCP_URL=https://mcp-client.delhivery.com/mcp
# D1_USER_EMAIL=you@example.com
# D1_CHANNEL_ID=xxxxxxxx
# D1_FACILITY_ID=xxxxxxxx
# D1_WAREHOUSE_UUID=delhivery::clientwarehouse::xxxxxxxx
# D1_ORIGIN_PIN=122017
